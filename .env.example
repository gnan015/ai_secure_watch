# AI SecureWatch environment example
# Copy the backend variables into backend/.env and the dashboard variables into dashboard/.env.
# Keep real secrets in your local machine or hosting provider only.

# Backend: FastAPI
APP_NAME=AI SecureWatch
APP_ENV=development
FRONTEND_URL=http://localhost:5173

# Backend: GitHub webhook and legacy token path
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_TOKEN=your_github_personal_access_token_here

# Backend: GitHub App integration
GITHUB_APP_ID=your_github_app_id_here
GITHUB_APP_PRIVATE_KEY=your_github_app_private_key_here
GITHUB_APP_WEBHOOK_SECRET=your_github_app_webhook_secret_here
GITHUB_APP_CLIENT_ID=your_github_app_client_id_here
GITHUB_APP_CLIENT_SECRET=your_github_app_client_secret_here

# Backend: AI analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Backend: Supabase
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Backend: alerts and automation
N8N_WEBHOOK_URL=your_n8n_webhook_url_here
DISCORD_WEBHOOK_ENCRYPTION_KEY=your_fernet_base64_key_here

# Dashboard: Vite public variables
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_GITHUB_APP_INSTALL_URL=https://github.com/apps/your-github-app/installations/new
